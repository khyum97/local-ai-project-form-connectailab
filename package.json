{
  "name": "yum-agent-company",
  "displayName": "Yum Agent Company",
  "description": "Personal local AI development team with specialist agents. Offline-first VS Code extension.",
  "version": "2.100.1",
  "publisher": "connectailab",
  "license": "MIT",
  "icon": "assets/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/wonseokjung/connect-ai"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Machine Learning",
    "Programming Languages",
    "Chat"
  ],
  "keywords": [
    "ai",
    "local",
    "ollama",
    "lmstudio",
    "gemma",
    "llama",
    "deepseek",
    "offline",
    "agent",
    "agent-team",
    "dev-team",
    "yum-agent-company",
    "solopreneur",
    "code-generation",
    "copilot"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "connect-ai-lab.newChat",
        "title": "Yum Agent: New Chat",
        "icon": "$(add)"
      },
      {
        "command": "connect-ai-lab.openSettings",
        "title": "Yum Agent: Open Settings"
      },
      {
        "command": "connect-ai-lab.exportChat",
        "title": "Yum Agent: Export Chat as Markdown"
      },
      {
        "command": "connect-ai-lab.explainSelection",
        "title": "Yum Agent: Explain Selected Code"
      },
      {
        "command": "connect-ai-lab.focusChat",
        "title": "Yum Agent: Focus Chat Input"
      },
      {
        "command": "connect-ai-lab.showBrainNetwork",
        "title": "Yum Agent: Show Brain Topology"
      },
      {
        "command": "connect-ai-lab.changeCompanyDir",
        "title": "Yum Agent: Change Company Folder"
      },
      {
        "command": "connect-ai-lab.connectCompanyRepo",
        "title": "Yum Agent: Connect Company GitHub"
      },
      {
        "command": "connect-ai-lab.connectGoogleCalendarWrite",
        "title": "Yum Agent: Connect Google Calendar Write"
      },
      {
        "command": "connectAiLab.tasks.refresh",
        "title": "Refresh Tasks",
        "category": "Yum Agent Company",
        "icon": "$(refresh)"
      },
      {
        "command": "connectAiLab.tasks.markDone",
        "title": "Mark Done",
        "category": "Yum Agent Company",
        "icon": "$(check)"
      },
      {
        "command": "connectAiLab.tasks.cancel",
        "title": "Cancel Task",
        "category": "Yum Agent Company",
        "icon": "$(close)"
      },
      {
        "command": "connectAiLab.tasks.setPriority",
        "title": "Change Priority",
        "category": "Yum Agent Company",
        "icon": "$(arrow-up)"
      },
      {
        "command": "connectAiLab.tasks.openTrackerJson",
        "title": "Open tracker.json",
        "category": "Yum Agent Company",
        "icon": "$(file-code)"
      },
      {
        "command": "connectAiLab.dailyBriefing.fireNow",
        "title": "Run Daily Briefing Now",
        "category": "Yum Agent Company",
        "icon": "$(megaphone)"
      },
      {
        "command": "connectAiLab.diagnoseConnection",
        "title": "Diagnose LLM Connection",
        "category": "Yum Agent Company",
        "icon": "$(pulse)"
      },
      {
        "command": "connectAiLab.youtube.refreshCommentQueue",
        "title": "Refresh YouTube Comment Queue",
        "category": "Yum Agent Company",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "connectAiLab.developer.scaffoldProject",
        "title": "Developer: Scaffold Project",
        "category": "Yum Agent Company",
        "icon": "$(file-directory-create)"
      },
      {
        "command": "connectAiLab.skill.saveLast",
        "title": "Save Last Output as Skill",
        "category": "Yum Agent Company",
        "icon": "$(star)"
      },
      {
        "command": "connectAiLab.youtube.connectOAuth",
        "title": "Connect YouTube OAuth",
        "category": "Yum Agent Company",
        "icon": "$(plug)"
      },
      {
        "command": "connectAiLab.dashboard.open",
        "title": "Open Company Dashboard",
        "category": "Yum Agent Company",
        "icon": "$(organization)"
      },
      {
        "command": "connectAiLab.apiConnections.open",
        "title": "Open API Connections",
        "category": "Yum Agent Company",
        "icon": "$(plug)"
      },
      {
        "command": "connectAiLab.revenueDashboard.open",
        "title": "Open Revenue Dashboard",
        "category": "Yum Agent Company",
        "icon": "$(graph-line)"
      }
    ],
    "keybindings": [
      {
        "command": "connect-ai-lab.focusChat",
        "key": "cmd+l",
        "mac": "cmd+l"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "connect-ai-lab.explainSelection",
          "when": "editorHasSelection",
          "group": "1_modification"
        }
      ],
      "view/title": [
        {
          "command": "connectAiLab.tasks.refresh",
          "when": "view == connectAiLab.tasks",
          "group": "navigation"
        },
        {
          "command": "connectAiLab.tasks.openTrackerJson",
          "when": "view == connectAiLab.tasks",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "connectAiLab.tasks.markDone",
          "when": "view == connectAiLab.tasks && viewItem == openTask",
          "group": "inline@1"
        },
        {
          "command": "connectAiLab.tasks.cancel",
          "when": "view == connectAiLab.tasks && viewItem == openTask",
          "group": "inline@2"
        },
        {
          "command": "connectAiLab.tasks.setPriority",
          "when": "view == connectAiLab.tasks && viewItem == openTask",
          "group": "1_actions"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "connect-ai-lab-sidebar",
          "title": "Yum Agent Company",
          "icon": "$(hubot)"
        }
      ]
    },
    "views": {
      "connect-ai-lab-sidebar": [
        {
          "type": "webview",
          "id": "connect-ai-lab-v2-view",
          "name": "Chat"
        }
      ]
    },
    "configuration": {
      "title": "Yum Agent Company",
      "properties": {
        "connectAiLab.ollamaUrl": {
          "type": "string",
          "default": "http://127.0.0.1:11434",
          "description": "AI server URL. Usually http://127.0.0.1:11434 for Ollama."
        },
        "connectAiLab.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Python 3 executable path. Leave empty for auto-detect, or set py -3, python3, or a full path."
        },
        "connectAiLab.defaultModel": {
          "type": "string",
          "default": "",
          "description": "Default local model name. Leave empty to auto-select an installed model."
        },
        "connectAiLab.requestTimeout": {
          "type": "number",
          "default": 300,
          "description": "AI response timeout in seconds."
        },
        "connectAiLab.streamFirstTokenTimeoutSec": {
          "type": "number",
          "default": 240,
          "description": "Timeout in seconds while waiting for the first streamed token."
        },
        "connectAiLab.streamIdleTimeoutSec": {
          "type": "number",
          "default": 60,
          "description": "Timeout in seconds between streamed tokens after a response starts."
        },
        "connectAiLab.localBrainPath": {
          "type": "string",
          "default": "",
          "description": "Local second-brain folder path. Markdown files inside become context."
        },
        "connectAiLab.secondBrainRepo": {
          "type": "string",
          "default": "",
          "description": "GitHub repository URL for second-brain backup and sync."
        },
        "connectAiLab.companyRepo": {
          "type": "string",
          "default": "",
          "description": "GitHub repository URL for company folder backup."
        },
        "connectAiLab.companyDir": {
          "type": "string",
          "default": "",
          "description": "Company folder path. Leave empty to create _company under the brain folder."
        },
        "connectAiLab.assetsPath": {
          "type": "string",
          "default": "",
          "description": "Optional asset folder path for custom office or character art."
        },
        "connectAiLab.autoCycleEnabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable autonomous work cycle when the user is idle."
        },
        "connectAiLab.dailyBriefingTime": {
          "type": "string",
          "default": "09:00",
          "description": "Daily briefing time in HH:MM format. Empty or off disables automatic briefing."
        },
        "connectAiLab.secretaryBridgeMode": {
          "type": "string",
          "enum": [
            "off",
            "output_only",
            "full"
          ],
          "enumDescriptions": [
            "Secretary disabled.",
            "Secretary summarizes specialist outputs only.",
            "Secretary reviews user input before CEO routing or direct reply."
          ],
          "default": "off",
          "description": "Secretary bridge mode between user input and specialist agents."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "esbuild src/extension.ts --bundle --platform=node --external:vscode --outfile=out/extension.js",
    "test:permission": "esbuild src/permissionPolicy.ts --bundle --platform=node --outfile=out/permissionPolicy.testable.js && node test/permissionPolicy.test.js",
    "test:guard": "esbuild src/agentOutputGuard.ts --bundle --platform=node --outfile=out/agentOutputGuard.testable.js && node test/agentOutputGuard.test.js",
    "test:agent-safety": "npm run test:permission && npm run test:guard",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "18.x",
    "@types/vscode": "^1.80.0",
    "@vercel/ncc": "^0.38.4",
    "esbuild": "^0.28.0",
    "typescript": "^5.1.3"
  },
  "dependencies": {
    "axios": "^1.15.0",
    "jsdom": "^29.0.2"
  }
}
